string DirectionText(int d)
{
   if(d>0)
      return "BUY";

   if(d<0)
      return "SELL";

   return "NONE";
}

void ExportAuditCSV()
{
   if(!InpExportCSV)
      return;

   string fn=InpReportPrefix+"_"+
             Symbol()+"_"+
             IntegerToString(Period())+".csv";

   int h=FileOpen(
      fn,
      FILE_CSV|FILE_WRITE|FILE_COMMON,
      ';'
   );

   if(h==INVALID_HANDLE)
   {
      Print("CSV open failed: ",GetLastError());
      return;
   }

   FileWrite(
      h,
      "strategy",
      "trades",
      "wins",
      "losses",
      "winrate",
      "gross_profit",
      "gross_loss",
      "profit_factor",
      "score",
      "max_loss_streak",
      "max_dd_points"
   );

   for(int i=0;i<ST_COUNT;i++)
   {
      double wr=
         SafeDiv(
            g_audit[i].wins,
            g_audit[i].trades,
            0.0
         );

      double pf=
         (g_audit[i].grossLoss>0.0 ?
          g_audit[i].grossProfit/
          g_audit[i].grossLoss :
          0.0);

      FileWrite(
         h,
         StrategyName(i),
         g_audit[i].trades,
         g_audit[i].wins,
         g_audit[i].losses,
         DoubleToString(wr,4),
         DoubleToString(g_audit[i].grossProfit,6),
         DoubleToString(g_audit[i].grossLoss,6),
         DoubleToString(pf,4),
         DoubleToString(g_audit[i].score,4),
         g_audit[i].maxLossStreak,
         DoubleToString(g_audit[i].maxDD/Point,2)
      );
   }

   FileWrite(
      h,
      "DIRECTION",
      "trades",
      "wins",
      "losses",
      "winrate",
      "gross_profit",
      "gross_loss",
      "profit_factor",
      "score",
      "max_loss_streak",
      "max_dd_points"
   );

   for(int d=0;d<2;d++)
   {
      double wr2=
         SafeDiv(
            g_dirAudit[d].wins,
            g_dirAudit[d].trades,
            0.0
         );

      double pf2=
         (g_dirAudit[d].grossLoss>0.0 ?
          g_dirAudit[d].grossProfit/
          g_dirAudit[d].grossLoss :
          0.0);

      FileWrite(
         h,
         DirectionText(d==0 ? 1 : -1),
         g_dirAudit[d].trades,
         g_dirAudit[d].wins,
         g_dirAudit[d].losses,
         DoubleToString(wr2,4),
         DoubleToString(g_dirAudit[d].grossProfit,6),
         DoubleToString(g_dirAudit[d].grossLoss,6),
         DoubleToString(pf2,4),
         DoubleToString(g_dirAudit[d].score,4),
         g_dirAudit[d].maxLossStreak,
         DoubleToString(g_dirAudit[d].maxDD/Point,2)
      );
   }

   FileClose(h);

   Print("Audit CSV exported: ",fn);
}

