void WriteTradeOutcomeHeader(int h)
{
   FileWrite(h,
      "ticket","entryTime","closeTime","direction","strategy","regime",
      "confidence","evidence","directionalEvidence","buyScore","sellScore",
      "ADX","ATR_points","RSI","EMA_gap_ATR","Momentum_ATR","BodyRatio",
      "SpreadPoints","profit","swap","commission","netProfit",
      "durationMinutes","outcome");
}

int WriteTradeOutcomeRows(int h)
{
   int rows=0;

   for(int i=0;i<g_decisionCount;i++)
   {
      DecisionRecord r=g_decisions[i];

      if(r.decision!="ORDER_ACCEPTED" || r.ticket<=0)
         continue;

      bool found=false;
      datetime entryTime=r.time;
      datetime closeTime=0;
      double profit=0.0;
      double swap=0.0;
      double commission=0.0;
      double net=0.0;

      for(int k=OrdersHistoryTotal()-1;k>=0;k--)
      {
         if(!OrderSelect(k,SELECT_BY_POS,MODE_HISTORY))
            continue;

         if(OrderTicket()!=r.ticket)
            continue;

         if(OrderSymbol()!=Symbol())
            continue;

         if(OrderMagicNumber()!=InpMagic)
            continue;

         found=true;
         entryTime=OrderOpenTime();
         closeTime=OrderCloseTime();
         profit=OrderProfit();
         swap=OrderSwap();
         commission=OrderCommission();
         net=profit+swap+commission;
         break;
      }

      string outcome="OPEN_OR_NOT_FOUND";

      if(found)
      {
         if(net>0.0)
            outcome="WIN";
         else if(net<0.0)
            outcome="LOSS";
         else
            outcome="FLAT";
      }

      long durationMinutes=0;

      if(found && closeTime>0 && entryTime>0)
         durationMinutes=(long)((closeTime-entryTime)/60);

      FileWrite(h,
         r.ticket,
         TimeToString(entryTime,TIME_DATE|TIME_MINUTES),
         (closeTime>0 ? TimeToString(closeTime,TIME_DATE|TIME_MINUTES) : ""),
         DirectionText(r.direction),
         StrategyName(r.strategy),
         RegimeName(r.regime),
         DoubleToString(r.confidence,4),
         DoubleToString(r.evidence,4),
         DoubleToString(r.directional,4),
         DoubleToString(r.buyScore,4),
         DoubleToString(r.sellScore,4),
         DoubleToString(r.adx,2),
         DoubleToString(r.atrPoints,1),
         DoubleToString(r.rsi,2),
         DoubleToString(r.emaGapATR,4),
         DoubleToString(r.momentumATR,4),
         DoubleToString(r.bodyRatio,4),
         DoubleToString(r.spreadPoints,1),
         DoubleToString(profit,2),
         DoubleToString(swap,2),
         DoubleToString(commission,2),
         DoubleToString(net,2),
         durationMinutes,
         outcome);

      rows++;
   }

   return rows;
}

void ExportTradeOutcomeAttribution()
{
   if(!InpExportCSV)
      return;

   string fn=InpReportPrefix+"_TradeOutcomeAttribution_"+
             Symbol()+"_"+IntegerToString(Period())+".csv";

   // Local tester/terminal Files directory.
   ResetLastError();

   int h=FileOpen(fn,FILE_CSV|FILE_WRITE,';');

   if(h==INVALID_HANDLE)
   {
      Print("TRADE_ATTR_EXPORT_LOCAL_OPEN_FAILED | file=",fn,
            " error=",GetLastError());
   }
   else
   {
      WriteTradeOutcomeHeader(h);

      int rows=WriteTradeOutcomeRows(h);

      FileFlush(h);
      FileClose(h);

      Print("TRADE_ATTR_EXPORT_LOCAL_OK | file=",fn,
            " rows=",rows,
            " accepted=",g_entriesAccepted);
   }

   // Shared MT4 Common\Files directory.
   ResetLastError();

   int hc=FileOpen(fn,FILE_CSV|FILE_WRITE|FILE_COMMON,';');

   if(hc==INVALID_HANDLE)
   {
      Print("TRADE_ATTR_EXPORT_COMMON_OPEN_FAILED | file=",fn,
            " error=",GetLastError());
   }
   else
   {
      WriteTradeOutcomeHeader(hc);

      int commonRows=WriteTradeOutcomeRows(hc);

      FileFlush(hc);
      FileClose(hc);

      Print("TRADE_ATTR_EXPORT_COMMON_OK | file=",fn,
            " rows=",commonRows,
            " accepted=",g_entriesAccepted);
   }
}

void PrintTradeOutcomeExportCheck()
{
   int accepted=0;
