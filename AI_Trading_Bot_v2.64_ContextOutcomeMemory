string StrategyName(int id)
{
   switch(id)
   {
      case ST_TREND:
         return "TREND_FOLLOWING";

      case ST_MEAN_REVERSION:
         return "MEAN_REVERSION";

      case ST_MOMENTUM:
         return "MOMENTUM";

      case ST_VOLATILITY_BREAKOUT:
         return "VOLATILITY_BREAKOUT";

      case ST_SESSION_BIAS:
         return "SESSION_BIAS";

      case ST_DIVERGENCE:
         return "DIVERGENCE";

      case ST_STRICT_RANGE:
         return "STRICT_RANGE";

      case ST_FRACTAL_HTF:
         return "FRACTAL_HTF";
   }

   return "UNKNOWN";
}

string RegimeName(int r)
{
   if(r == REGIME_TREND)
      return "TREND";

   if(r == REGIME_RANGE)
      return "RANGE";

   if(r == REGIME_BREAKOUT)
      return "BREAKOUT";

   return "UNKNOWN";
}

//==================================================================
// BASIC UTILITIES
//==================================================================
bool NewBar()
{
   datetime t = iTime(Symbol(), Period(), 0);

   if(t == 0)
      return false;

   if(t != g_lastBarTime)
   {
      g_lastBarTime = t;
      return true;
   }

   return false;
}

double ATR(int shift)
{
   return iATR(
      Symbol(),
      Period(),
      InpATRPeriod,
      shift
   );
}

double ADX(int shift)
{
   return iADX(
      Symbol(),
      Period(),
      InpADXPeriod,
      PRICE_CLOSE,
      MODE_MAIN,
      shift
   );
}

double RSI(int shift)
{
   return iRSI(
      Symbol(),
      Period(),
      InpRSIPeriod,
      PRICE_CLOSE,
      shift
   );
}

double EMA(int period, int shift)
{
   return iMA(
      Symbol(),
      Period(),
      period,
      0,
      MODE_EMA,
      PRICE_CLOSE,
      shift
   );
}

double SafeDiv(
   double a,
   double b,
   double fallback = 0.0
)
{
   if(MathAbs(b) < 1e-10)
      return fallback;

   return a / b;
}

double CandleBodyRatio(int shift)
{
   double range = High[shift] - Low[shift];

   if(range <= Point)
      return 0.0;

   return MathAbs(
      Close[shift] - Open[shift]
   ) / range;
}

double MomentumATR(int shift)
{
   double a = ATR(shift);

   if(a <= 0.0)
      return 0.0;

   return SafeDiv(
      Close[shift] - Close[shift+3],
      a,
      0.0
   );
}

double EmaGapATR(int shift)
{
   double a = ATR(shift);

   if(a <= 0.0)
      return 0.0;

   return SafeDiv(
      EMA(InpFastEMA, shift) -
      EMA(InpSlowEMA, shift),
      a,
      0.0
   );
}

bool InSession()
{
   int h = TimeHour(TimeCurrent());

   if(InpSessionStartHour <= InpSessionEndHour)
      return (
         h >= InpSessionStartHour &&
         h < InpSessionEndHour
      );

   return (
      h >= InpSessionStartHour ||
      h < InpSessionEndHour
   );
}

double CurrentSpreadPoints()
{
   RefreshRates();

   return SafeDiv(
      Ask - Bid,
      Point,
      0.0
   );
}

bool SpreadOK()
{
   double sp = CurrentSpreadPoints();

   bool bypassMin =
      (
         IsTesting() &&
         InpBacktestExecution &&
         InpTesterBypassSpreadMinimum
      );

   if(
      (!bypassMin && sp < InpMinSpreadPoints) ||
      sp > InpMaxSpreadPoints
   )
      return false;

   if(InpUseSpreadATRFilter)
   {
      double a = ATR(1);

      if(
         a > 0.0 &&
         SafeDiv(
            sp * Point,
            a,
            999.0
         ) > InpMaxSpreadATR
      )
         return false;
   }

   return true;
}

int OpenTradeCount()
{
   int n = 0;

   for(int i = OrdersTotal()-1; i >= 0; i--)
   {
      if(!OrderSelect(
         i,
         SELECT_BY_POS,
         MODE_TRADES
      ))
         continue;

      if(OrderSymbol() != Symbol())
         continue;

      if(OrderMagicNumber() != InpMagic)
         continue;

      n++;
   }

   return n;
}

double TodayClosedProfit()
{
   datetime dayStart =
      StrToTime(
         TimeToString(
            TimeCurrent(),
            TIME_DATE
         )
      );

   double p = 0.0;

   for(
      int i = OrdersHistoryTotal()-1;
      i >= 0;
      i--
   )
   {
      if(!OrderSelect(
         i,
         SELECT_BY_POS,
         MODE_HISTORY
      ))
         continue;

      if(OrderSymbol() != Symbol())
         continue;

      if(OrderMagicNumber() != InpMagic)
         continue;

      if(OrderCloseTime() < dayStart)
         continue;

      p +=
         OrderProfit() +
         OrderSwap() +
         OrderCommission();
   }

   return p;
}

bool DailyLossOK()
{
   double bal = AccountBalance();

   if(bal <= 0.0)
      return false;

   double lossPct =
      -100.0 *
      TodayClosedProfit() /
      bal;

   if(lossPct <= 0.0)
      return true;

   return lossPct < InpMaxDailyLossPercent;
}

//==================================================================
// REGIME
//==================================================================
int DetectRegime(int shift)
{
   double adx = ADX(shift);
   double a   = ATR(shift);

   if(a <= 0.0)
      return REGIME_UNKNOWN;

   double atrPoints = a / Point;

   double body =
      CandleBodyRatio(shift);

   double range =
      High[shift] -
      Low[shift];

   if(adx >= InpMinADXTrend)
      return REGIME_TREND;

   if(adx <= InpMaxADXRange)
      return REGIME_RANGE;

   if(
      atrPoints >= InpMinATRPoints &&
      range > a * 1.25 &&
      body >= 0.55
   )
      return REGIME_BREAKOUT;

   return REGIME_UNKNOWN;
}

//==================================================================
// 8 STRATEGY SIGNALS
// Returns +1 BUY, -1 SELL, 0 neutral
//==================================================================
int SignalTrend(int s)
{
   double f  = EMA(InpFastEMA,s);
   double sl = EMA(InpSlowEMA,s);
   double tr = EMA(InpTrendEMA,s);

   if(
      f > sl &&
      sl > tr &&
      Close[s] > f
   )
      return 1;

   if(
      f < sl &&
      sl < tr &&
      Close[s] < f
   )
      return -1;

   return 0;
}

int SignalMeanReversion(int s)
{
   double r = RSI(s);
   double f = EMA(InpFastEMA,s);

   if(
      r <= 30.0 &&
      Close[s] < f
   )
      return 1;

   if(
      r >= 70.0 &&
      Close[s] > f
   )
      return -1;

   return 0;
}

int SignalMomentum(int s)
{
   double m = MomentumATR(s);
   double r = RSI(s);

   if(
      m > 0.35 &&
      r > 52.0
   )
      return 1;

   if(
      m < -0.35 &&
      r < 48.0
   )
      return -1;

   return 0;
}

int SignalVolatilityBreakout(int s)
{
   double a = ATR(s);

   if(a <= 0.0)
      return 0;

   double priorHigh = High[s+1];
   double priorLow  = Low[s+1];

   if(
      Close[s] > priorHigh &&
      (High[s]-Low[s]) > a*0.90
   )
      return 1;

   if(
      Close[s] < priorLow &&
      (High[s]-Low[s]) > a*0.90
   )
      return -1;

   return 0;
}

int SignalSessionBias(int s)
{
   int h = TimeHour(Time[s]);

   if(h >= 7 && h < 13)
   {
      if(Close[s] > Open[s])
         return 1;

      if(Close[s] < Open[s])
         return -1;
   }

   if(h >= 13 && h < 20)
   bool AdaptiveEntryAllowed(int direction, double confidence, string &reason)
{
   reason = "";

   if(!InpAdaptiveEntry)
   {
      reason = "adaptive entry disabled";
      return true;
   }

   if(confidence < InpAdaptiveMinConfidence)
   {
      reason = "confidence below adaptive minimum";
      return false;
   }

   int regime = DetectRegime(1);
   double a = ATR(1);

   if(a <= 0.0)
   {
      reason = "ATR unavailable";
      return false;
   }

   double emaGap = EmaGapATR(1);
   double mom = MomentumATR(1);
   double body = CandleBodyRatio(1);

   bool regimeOK = true;

   if(InpRequireRegimeCompatibility)
   {
      if(regime == REGIME_TREND)
         regimeOK = (direction > 0 ? emaGap > 0.0 : emaGap < 0.0);
      else if(regime == REGIME_RANGE)
         regimeOK = true;
      else if(regime == REGIME_BREAKOUT)
         regimeOK = (direction > 0 ? mom > 0.0 : mom < 0.0);
   }

   if(InpRequireRegimeCompatibility && !regimeOK)
   {
      reason = "regime compatibility failed";
      return false;
   }

   if(InpRequireRegimeDirection)
   {
      bool directionOK =
         (direction > 0 ? emaGap >= 0.0 : emaGap <= 0.0);

      if(!directionOK)
      {
         reason = "regime direction failed";
         return false;
      }
   }

   if(InpAdaptiveRequireCandleConfirmation ||
      InpRequireCandleBodyFilter)
   {
      if(body < InpMinCandleBodyRatio)
      {
         reason = "candle body confirmation failed";
         return false;
      }
   }

   // Pullback / breakout geometry is diagnostic by default.
   // It becomes a hard gate only through explicit regime options.
   if(regime == REGIME_BREAKOUT)
   {
      if(MathAbs(mom) < InpAdaptiveBreakoutATR)
      {
         reason = "breakout momentum weak";

         if(InpRequireRegimeCompatibility)
            return false;
      }
   }

   if(regime == REGIME_TREND)
   {
      if(MathAbs(emaGap) < InpAdaptivePullbackATR &&
         confidence < InpAdaptiveStrongConfidence)
      {
         reason = "trend geometry soft warning";
      }
   }

   if(reason == "")
      reason = "adaptive entry accepted";

   return true;
}

