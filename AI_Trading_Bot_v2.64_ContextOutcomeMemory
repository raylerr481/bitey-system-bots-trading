//==================================================================
// ORDER EXECUTION
//==================================================================
bool ExecuteTrade(int direction, int selectedStrategy, double confidence)
{
   string reason="";

   bool riskOK=RiskGate(reason);

   double evidence=0.0;
   double buyEvidence=0.0;
   double sellEvidence=0.0;

   int bv=0;
   int sv=0;
   int sel=-1;

   double bs=0.0;
   double ss=0.0;
   double c2=0.0;

   // Recompute for diagnostics without changing counters.
   int diag=LocalAISignal(
      c2,
      evidence,
      buyEvidence,
      sellEvidence,
      sel,
      bv,
      sv,
      bs,
      ss
   );

   bool adaptiveOK=true;
   string adaptiveReason="";

   adaptiveOK=AdaptiveEntryAllowed(
      direction,
      confidence,
      adaptiveReason
   );

   g_lastAdaptiveReason=adaptiveReason;
   g_lastRiskReason=reason;

   BuildDecisionSnapshot(
      direction,
      selectedStrategy,
      bv,
      sv,
      confidence,
      evidence,
      buyEvidence,
      sellEvidence,
      bs,
      ss,
      adaptiveOK,
      riskOK
   );

   if(InpDecisionAuditEnabled)
      PrintDecision();

   if(!riskOK)
   {
      g_entriesRejected++;

      RecordDecision("BLOCK_RISK");

      return false;
   }

   if(!adaptiveOK)
   {
      g_blockedAdaptive++;
      g_entriesRejected++;

      RecordDecision("BLOCK_ADAPTIVE");

      return false;
   }

   RefreshRates();

   double a=ATR(1);

   if(a<=0.0)
   {
      g_entriesRejected++;
      return false;
   }

   double slDist=a*InpSL_ATR;
   double tpDist=a*InpTP_ATR;

   double lot=LotForRisk(slDist);

   double price=(direction>0 ? Ask : Bid);

   double sl=(direction>0 ?
              price-slDist :
              price+slDist);

   double tp=(direction>0 ?
              price+tpDist :
              price-tpDist);

   int digits=(int)MarketInfo(Symbol(),MODE_DIGITS);

   price=NormalizeDouble(price,digits);
   sl=NormalizeDouble(sl,digits);
   tp=NormalizeDouble(tp,digits);

   string comment="Bitey51|";

   comment += StrategyName(selectedStrategy);
   comment += "|";
   comment += (direction>0 ? "BUY" : "SELL");

   int ticket=OrderSend(
      Symbol(),
      (direction>0 ? OP_BUY : OP_SELL),
      lot,
      price,
      InpSlippage,
      sl,
      tp,
      comment,
      InpMagic,
      0,
      clrNONE
   );

   if(ticket<0)
   {
      int err=GetLastError();

      Print(
         "OrderSend failed. Error=",err,
         " dir=",direction,
         " strategy=",StrategyName(selectedStrategy)
      );

      g_orderSendFailed++;
      g_entriesRejected++;

      RecordDecision("ORDER_SEND_FAILED");

      return false;
   }

   g_entriesAccepted++;
   g_lastOrderTicket=ticket;

   RecordDecision("ORDER_ACCEPTED");

   Print(
      "ORDER ACCEPTED | ticket=",ticket,
      " dir=",direction,
      " strategy=",StrategyName(selectedStrategy),
      " lot=",DoubleToString(lot,2),
      " conf=",DoubleToString(confidence,3)
   );

   return true;
}

