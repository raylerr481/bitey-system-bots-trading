double ATR(int shift)
{
   return iATR(Symbol(),
               Period(),
               InpATRPeriod,
               shift);
}



double ADX(int shift)
{
   return iADX(Symbol(),
               Period(),
               InpADXPeriod,
               PRICE_CLOSE,
               MODE_MAIN,
               shift);
}



double RSI(int shift)
{
   return iRSI(Symbol(),
               Period(),
               InpRSIPeriod,
               PRICE_CLOSE,
               shift);
}



double EMA(int period,int shift)
{
   return iMA(Symbol(),
              Period(),
              period,
              0,
              MODE_EMA,
              PRICE_CLOSE,
              shift);
}



double CandleBody(int shift)
{
   return MathAbs(
      iClose(Symbol(),Period(),shift)
      -
      iOpen(Symbol(),Period(),shift)
   );
}



double CandleRange(int shift)
{
   return iHigh(Symbol(),Period(),shift)
          -
          iLow(Symbol(),Period(),shift);
}



bool IsNewBar()
{
   datetime t=iTime(Symbol(),
                    Period(),
                    0);


   if(t<=0)
      return false;


   if(t!=gLastBarTime)
   {
      gLastBarTime=t;
      return true;
   }


   return false;
}



bool HasEnoughBars()
{
   int minimum=
      InpTrendEMA+
      InpTrainBars+
      InpOOSBars+
      InpHurstPeriod+
      100;


   return Bars>minimum;
}



//==================================================================
// STANDARD DEVIATION
//==================================================================


double StdDev(int shift,int period)
{

   if(period<2)
      return 0;


   double mean=0;


   for(int i=shift;
       i<shift+period;
       i++)
   {
      mean+=iClose(Symbol(),
                   Period(),
                   i);
   }


   mean/=period;


   double variance=0;


   for(int j=shift;
       j<shift+period;
       j++)
   {

      double d=
         iClose(Symbol(),
                Period(),
                j)
         -
         mean;


      variance+=d*d;
   }


   variance/=(period-1);


   return MathSqrt(variance);
}



//==================================================================
// HURST ESTIMATION
//==================================================================


double HurstExponent(int shift)
{

   int n=InpHurstPeriod;


   if(n<20 ||
      Bars<shift+n+5)
      return 0.50;



   double mean=0;


   for(int i=0;i<n;i++)
   {
      mean+=iClose(Symbol(),
                   Period(),
                   shift+i);
   }


   mean/=n;



   double cumulative=0;

   double maxDev=-DBL_MAX;

   double minDev=DBL_MAX;

   double variance=0;



   for(int j=0;j<n;j++)
   {

      double dev=
         iClose(Symbol(),
                Period(),
                shift+j)
         -
         mean;


      cumulative+=dev;


      if(cumulative>maxDev)
         maxDev=cumulative;


      if(cumulative<minDev)
         minDev=cumulative;


      variance+=dev*dev;
   }



   double sd=
      MathSqrt(variance/n);



   if(sd<=0)
      return 0.50;



   double R=maxDev-minDev;


   if(R<=0)
      return 0.50;



   double rs=R/sd;


   if(rs<=0)
      return 0.50;



   double h=
      MathLog(rs)/
      MathLog(n);



   if(h<0)
      h=0;


   if(h>1)
      h=1;



   return h;
}



//==================================================================
// VOLATILITY RATIOS
//==================================================================


double ATRRatio(int shift)
{

   double current=ATR(shift);


   if(current<=0)
      return 1;


   double avg=0;


   for(int i=shift+1;
       i<=shift+InpRegimeLookback;
       i++)
   {
      avg+=ATR(i);
   }


   avg/=InpRegimeLookback;


   if(avg<=0)
      return 1;


   return current/avg;
}



double StdRatio(int shift)
{

   double current=
      StdDev(shift,
             InpRegimeLookback);


   if(current<=0)
      return 1;



   double avg=0;



   for(int i=shift+1;
       i<=shift+InpRegimeLookback;
       i++)
   {
      avg+=StdDev(i,
                  InpRegimeLookback);
   }



   avg/=InpRegimeLookback;



   if(avg<=0)
      return 1;



   return current/avg;
}



//==================================================================
// REGIME DETECTION v2.33
//==================================================================


int DetectRegime(int shift)
{

   double atrRatio=
      ATRRatio(shift);


   double stdRatio=
      StdRatio(shift);


   double adx=
      ADX(shift);


   double hurst=
      HurstExponent(shift);



   double fast=
      EMA(InpFastEMA,shift);


   double slow=
      EMA(InpSlowEMA,shift);


   double trend=
      EMA(InpTrendEMA,shift);



   double close=
      iClose(Symbol(),
             Period(),
             shift);



   gCurrentATRRatio=atrRatio;

   gCurrentStdRatio=stdRatio;

   gCurrentADX=adx;

   gCurrentHurst=hurst;



   // High volatility trend

   if(atrRatio>=InpATRExpansion &&
      stdRatio>=InpATRExpansion &&
      adx>=InpTrendADX)
   {
      return REGIME_HIGH_VOL;
   }



   // Breakout detection


   double high12=-DBL_MAX;

   double low12=DBL_MAX;



   for(int i=shift+1;
       i<=shift+12;
       i++)
   {

      high12=
      MathMax(high12,
              iHigh(Symbol(),
                    Period(),
                    i));


      low12=
      MathMin(low12,
              iLow(Symbol(),
                   Period(),
                   i));

   }



   if((close>high12 ||
       close<low12)
       &&
       atrRatio>1.05)
   {
      return REGIME_BREAKOUT;
   }




   // Trend


   if(adx>=InpTrendADX)
   {

      if(close>trend &&
         fast>slow)
      {
         return REGIME_TREND_UP;
      }



      if(close<trend &&
         fast<slow)
      {
         return REGIME_TREND_DOWN;
      }

   }




   // Compression


   if(atrRatio<=InpATRContraction &&
      stdRatio<=InpATRContraction)
   {
      return REGIME_CONTRACTING;
   }




   // Range


   if(adx<=InpRangeADX ||
      hurst<=InpHurstRange)
   {
      return REGIME_RANGE;
   }




   // Hurst trend persistence


   if(hurst>=InpHurstTrend)
   {

      if(close>trend &&
         fast>slow)
         return REGIME_TREND_UP;



      if(close<trend &&
         fast<slow)
         return REGIME_TREND_DOWN;

   }



   return REGIME_TRANSITION;
}



//==================================================================
// UPDATE REGIME
//==================================================================


void UpdateRegime(int shift)
{

   int detected=
      DetectRegime(shift);



   if(gCurrentRegime==REGIME_UNKNOWN)
   {
      gCurrentRegime=detected;
      gPreviousRegime=detected;
      return;
   }



   if(detected!=gCurrentRegime)
   {

      gPreviousRegime=
         gCurrentRegime;


      gCurrentRegime=
         detected;



      gLastCalibrationBar=-1;



      if(InpVerbose)
      {
         Print(
         "B33 REGIME CHANGE ",
         gPreviousRegime,
         " -> ",
         gCurrentRegime,
         " ATR=",
         DoubleToString(gCurrentATRRatio,2),
         " ADX=",
         DoubleToString(gCurrentADX,2),
         " HURST=",
         DoubleToString(gCurrentHurst,3)
         );
      }

   }

}


