//==================================================================
// STRATEGY COMPATIBILITY v2.33
// Adaptive regime tolerance
//==================================================================

bool StrategyCompatible(int strategy,int direction)
{
   int r=gCurrentRegime;


   //===============================================================
   // TREND FAMILY
   //===============================================================

   if(strategy==STRAT_TREND ||
      strategy==STRAT_MOMENTUM ||
      strategy==STRAT_FRACTAL_HTF)
   {

      if(r==REGIME_TREND_UP &&
         direction==SIGNAL_BUY)
         return true;


      if(r==REGIME_TREND_DOWN &&
         direction==SIGNAL_SELL)
         return true;


      // High volatility accepts both directions
      if(r==REGIME_HIGH_VOL)
         return true;


      // v2.33 FIX:
      // Transition no longer blocks everything
      if(r==REGIME_TRANSITION)
      {
         if(gCurrentADX>=InpTrendADXFailsafe)
            return true;
      }


      return false;
   }



   //===============================================================
   // BREAKOUT
   //===============================================================

   if(strategy==STRAT_BREAKOUT)
   {

      if(r==REGIME_BREAKOUT ||
         r==REGIME_HIGH_VOL)
         return true;


      // adaptive breakout
      if(r==REGIME_TRANSITION &&
         gCurrentATRRatio>=1.10 &&
         gCurrentADX>=18)
         return true;


      return false;
   }



   //===============================================================
   // MEAN REVERSION FAMILY
   //===============================================================

   if(strategy==STRAT_MEANREV ||
      strategy==STRAT_RANGE ||
      strategy==STRAT_DIVERGENCE)
   {

      if(r==REGIME_RANGE ||
         r==REGIME_CONTRACTING)
         return true;


      // softer transition
      if(r==REGIME_TRANSITION &&
         gCurrentADX<=20)
         return true;


      return false;
   }



   //===============================================================
   // SESSION STRATEGY
   //===============================================================

   if(strategy==STRAT_SESSION)
   {

      if(r!=REGIME_UNKNOWN)
         return true;

   }


   return false;
}



//==================================================================
// QUALITY CHECK v2.33
// Less blocking, more scoring
//==================================================================

bool QualityOK(int strategy,
               int direction,
               int shift)
{

   double atr=ATR(shift);


   if(atr<=0)
      return false;



   double close0=
      iClose(Symbol(),
             Period(),
             shift);


   double fast=
      EMA(InpFastEMA,
          shift);


   double slow=
      EMA(InpSlowEMA,
          shift);


   double body=
      CandleBody(shift);



   //---------------------------------------------------------------
   // TREND STYLE
   //---------------------------------------------------------------

   if(strategy==STRAT_TREND ||
      strategy==STRAT_MOMENTUM ||
      strategy==STRAT_BREAKOUT ||
      strategy==STRAT_FRACTAL_HTF)
   {

      // v2.33:
      // reduced from 0.10 ATR
      // to avoid zero entries

      if(body < atr*0.05)
         return false;



      // EMA separation filter

      if(MathAbs(fast-slow)<atr*0.02)
         return false;



      if(direction==SIGNAL_BUY &&
         close0<slow)
         return false;



      if(direction==SIGNAL_SELL &&
         close0>slow)
         return false;

   }



   //---------------------------------------------------------------
   // MOMENTUM ADAPTIVE
   //---------------------------------------------------------------

   if(InpAdaptiveEntry &&
      strategy==STRAT_MOMENTUM)
   {

      double rsi=
         RSI(shift);


      if(direction==SIGNAL_BUY &&
         rsi<45)
         return false;


      if(direction==SIGNAL_SELL &&
         rsi>55)
         return false;

   }



   return true;
}



//==================================================================
// VALID SIGNAL v2.33
// Pipeline diagnostics
//==================================================================

int ValidSignal(int strategy,
                int shift,
                bool countStats)
{

   int signal=
      RawSignal(strategy,
                shift);



   if(signal==SIGNAL_NONE)
      return SIGNAL_NONE;



   if(countStats)
   {
      gRawSignals[strategy]++;
      gStrategyDetected[strategy]++;
   }



   //---------------------------------------------------------------
   // QUALITY
   //---------------------------------------------------------------

   if(!QualityOK(strategy,
                 signal,
                 shift))
   {

      if(countStats)
         gRejectedQuality++;


      return SIGNAL_NONE;
   }



   if(countStats)
      gQualityPass[strategy]++;



   //---------------------------------------------------------------
   // REGIME
   //---------------------------------------------------------------

   if(!StrategyCompatible(strategy,
                          signal))
   {

      if(countStats)
         gRejectedContext++;


      return SIGNAL_NONE;
   }



   if(countStats)
   {
      gContextPass[strategy]++;
      gStrategyQualified[strategy]++;
   }



   return signal;
}



//==================================================================
// ADAPTIVE STRATEGY PRIORITY
//==================================================================

int StrategyPriority(int index)
{

   switch(index)
   {

      case 0:
         return STRAT_TREND;

      case 1:
         return STRAT_MOMENTUM;

      case 2:
         return STRAT_BREAKOUT;

      case 3:
         return STRAT_SESSION;

      case 4:
         return STRAT_RANGE;

      case 5:
         return STRAT_MEANREV;

      case 6:
         return STRAT_DIVERGENCE;

      case 7:
         return STRAT_FRACTAL_HTF;
   }


   return STRAT_TREND;
}



//==================================================================
// ADAPTIVE SIGNAL SELECTOR v2.33
// Main zero-trade fix
//==================================================================

bool SelectSignal(int shift,
                  int &strategy,
                  int &direction)
{

   strategy=-1;
   direction=SIGNAL_NONE;



   //---------------------------------------------------------------
   // 1. Try Walk Forward winner
   //---------------------------------------------------------------

   if(gBestStrategy>=0)
   {

      int bestSignal=
         ValidSignal(gBestStrategy,
                     shift,
                     true);


      if(bestSignal!=SIGNAL_NONE)
      {

         strategy=gBestStrategy;
         direction=bestSignal;

         gSelectedSignals++;

         return true;
      }

   }



   //---------------------------------------------------------------
   // 2. Adaptive fallback
   //---------------------------------------------------------------


   for(int i=0;i<STRAT_COUNT;i++)
   {

      int s=
         StrategyPriority(i);



      if(s==gBestStrategy)
         continue;



      int signal=
         ValidSignal(s,
                     shift,
                     true);



      if(signal==SIGNAL_NONE)
         continue;



      strategy=s;
      direction=signal;


      gSelectedSignals++;


      if(InpVerbose)
      {
         Print("B33 ADAPTIVE FALLBACK ",
               StrategyName(strategy),
               " DIR=",
               direction==SIGNAL_BUY?
               "BUY":"SELL");
      }


      return true;
   }



   //---------------------------------------------------------------
   // 3. Emergency adaptive entry
   //---------------------------------------------------------------

   if(InpAdaptiveEntry)
   {

      int trendSignal=
         RawSignal(STRAT_TREND,
                   shift);



      if(trendSignal!=SIGNAL_NONE)
      {

         strategy=STRAT_TREND;
         direction=trendSignal;


         gSelectedSignals++;


         Print("B33 EMERGENCY TREND ENTRY");


         return true;
      }

   }



   return false;
}

//==================================================================
// SCORE STRATEGY v2.33
// Adaptive scoring - no total elimination
//==================================================================

double ScoreStrategy(AuditStats &train,
                     AuditStats &oos)
{

   double score=0.0;



   //---------------------------------------------------------------
   // Sample size
   //---------------------------------------------------------------

   if(train.trades < InpMinTrainTrades)
   {
      score-=40;
   }
   else
   {
      score+=MathMin(train.trades,30);
   }



   if(oos.trades < InpMinOOSTrades)
   {
      score-=35;
   }
   else
   {
      score+=oos.trades*1.5;
   }



   //---------------------------------------------------------------
   // Profit Factor
   //---------------------------------------------------------------

   if(oos.profitFactor>0)
   {
      score +=
      oos.profitFactor*35.0;
   }
   else
   {
      score-=20;
   }



   //---------------------------------------------------------------
   // Expectancy
   //---------------------------------------------------------------

   score +=
   oos.expectancy*120.0;



   //---------------------------------------------------------------
   // Payoff
   //---------------------------------------------------------------

   if(oos.payoff>0)
      score+=oos.payoff*8.0;



   //---------------------------------------------------------------
   // Stability
   //---------------------------------------------------------------

   if(train.profitFactor>0 &&
      oos.profitFactor>0)
   {

      double stability=
      oos.profitFactor/
      train.profitFactor;


      if(stability>1)
         stability=1;


      score+=
      stability*20;
   }



   //---------------------------------------------------------------
   // Drawdown control
   //---------------------------------------------------------------

   score-=
   oos.maxDrawdown*2.5;



   //---------------------------------------------------------------
   // v2.33 protection
   // Never allow all strategies dead
   //---------------------------------------------------------------

   if(score<-500)
      score=-500;



   return score;
}



//==================================================================
// WALK FORWARD v2.33
// Adaptive calibration
//==================================================================

void WalkForward(int shift)
{

   gBestStrategy=-1;

   gBestScore=-999999;

   gBestPF=0;

   gBestExp=-999;

   gBestDD=100;

   gBestTrainTrades=0;

   gBestOOSTrades=0;



   double secondBest=-999999;



   for(int s=0;
       s<STRAT_COUNT;
       s++)
   {

      AuditStats train;
      AuditStats oos;



      AuditStrategy(s,
                    shift,
                    train,
                    oos);



      double score=
      ScoreStrategy(train,
                    oos);



      if(InpVerbose)
      {

         Print(
         "B33 WF ",
         StrategyName(s),

         " TRAIN=",
         train.trades,

         " OOS=",
         oos.trades,

         " PF=",
         DoubleToString(
         oos.profitFactor,3),

         " EXP=",
         DoubleToString(
         oos.expectancy,4),

         " DD=",
         DoubleToString(
         oos.maxDrawdown,3),

         " SCORE=",
         DoubleToString(
         score,2)
         );

      }



      //------------------------------------------------------------
      // Ranking
      //------------------------------------------------------------

      if(score > gBestScore)
      {

         secondBest=
         gBestScore;


         gBestScore=score;


         gBestStrategy=s;


         gBestPF=
         oos.profitFactor;


         gBestExp=
         oos.expectancy;


         gBestDD=
         oos.maxDrawdown;


         gBestTrainTrades=
         train.trades;


         gBestOOSTrades=
         oos.trades;

      }

   }



   //---------------------------------------------------------------
   // Safety fallback
   //---------------------------------------------------------------

   if(gBestStrategy<0)
   {

      gBestStrategy=
      STRAT_SESSION;


      gBestScore=0;


      Print(
      "B33 WF FALLBACK SESSION"
      );

   }



   gCalibrationCount++;


   gLastCalibrationBar=
   (int)gBarSequence;



   if(InpVerbose)
   {

      Print(
      "================================"
      );


      Print(
      "B33 WF BEST=",
      StrategyName(gBestStrategy),

      " SCORE=",
      DoubleToString(
      gBestScore,2),

      " PF=",
      DoubleToString(
      gBestPF,3),

      " EXP=",
      DoubleToString(
      gBestExp,4),

      " DD=",
      DoubleToString(
      gBestDD,3),

      " TRAIN=",
      gBestTrainTrades,

      " OOS=",
      gBestOOSTrades
      );


      Print(
      "================================"
      );

   }

}



//==================================================================
// ADAPTIVE RECALIBRATION CONTROL v2.33
//==================================================================

bool NeedRecalibration()
{

   //---------------------------------------------------------------
   // First calibration
   //---------------------------------------------------------------

   if(gBestStrategy<0)
      return true;



   //---------------------------------------------------------------
   // Regular interval
   //---------------------------------------------------------------

   if(
   (gBarSequence-gLastCalibrationBar)
   >=InpRecalibrationBars
   )
      return true;



   //---------------------------------------------------------------
   // Regime change
   //---------------------------------------------------------------

   if(gPreviousRegime!=
      gCurrentRegime)
      return true;



   //---------------------------------------------------------------
   // High volatility
   //---------------------------------------------------------------

   if(gCurrentATRRatio>=
      InpATRExpansion)
      return true;



   return false;
}
//==================================================================
// SPREAD INTELLIGENCE v2.33
//==================================================================

bool SpreadOK()
{

   RefreshRates();


   double spreadPoints=
   (Ask-Bid)/Point;


   gLastSpreadPoints=
   spreadPoints;



   //---------------------------------------------------------------
   // Hard limit
   //---------------------------------------------------------------

   if(spreadPoints >
      InpMaxSpreadPoints)
   {

      gBlockSpread++;


      return false;
   }



   //---------------------------------------------------------------
   // ATR dynamic spread
   //---------------------------------------------------------------

   double atr=
   ATR(1);



   if(atr<=0)
      return false;



   double ratio=
   (spreadPoints*Point)/atr;



   gLastSpreadATRRatio=
   ratio;



   //---------------------------------------------------------------
   // v2.33 adaptive:
   // during high volatility allow more spread
   //---------------------------------------------------------------

   double maxRatio=
   InpMaxSpreadATR;



   if(gCurrentRegime==
      REGIME_HIGH_VOL)
   {
      maxRatio*=1.5;
   }



   if(ratio>maxRatio)
   {

      gSpreadAtrBlocks++;


      return false;

   }



   return true;
}



//==================================================================
// LOT CALCULATION v2.33
//==================================================================

double CalculateLots(double stopDistance)
{

   if(stopDistance<=0)
      return 0;



   double riskMoney=

   AccountBalance()
   *
   InpRiskPercent
   /
   100.0;



   double tickValue=

   MarketInfo(Symbol(),
   MODE_TICKVALUE);



   double tickSize=

   MarketInfo(Symbol(),
   MODE_TICKSIZE);



   if(tickValue<=0 ||
      tickSize<=0)
      return 0;



   double moneyPerLot=

   (stopDistance/tickSize)
   *
   tickValue;



   if(moneyPerLot<=0)
      return 0;



   double lots=

   riskMoney/
   moneyPerLot;



   double minLot=

   MarketInfo(Symbol(),
   MODE_MINLOT);



   double maxLot=

   MarketInfo(Symbol(),
   MODE_MAXLOT);



   double step=

   MarketInfo(Symbol(),
   MODE_LOTSTEP);



   if(step<=0)
      step=0.01;



   lots=
   MathFloor(lots/step)
   *
   step;



   //---------------------------------------------------------------
   // v2.33
   // Never return invalid lot
   //---------------------------------------------------------------

   if(lots<minLot)
      lots=minLot;



   if(lots>maxLot)
      lots=maxLot;



   return NormalizeDouble(
   lots,2);

}



//==================================================================
// STOP VALIDATION v2.33
//==================================================================

bool StopsValid(int direction,
                double entry,
                double sl,
                double tp)
{

   double stopLevel=

   MarketInfo(Symbol(),
   MODE_STOPLEVEL)
   *
   Point;



   if(stopLevel<Point)
      stopLevel=Point*2;



   if(direction==
      SIGNAL_BUY)
   {

      if(entry-sl <
         stopLevel)
         return false;



      if(tp-entry <
         stopLevel)
         return false;

   }



   if(direction==
      SIGNAL_SELL)
   {

      if(sl-entry <
         stopLevel)
         return false;



      if(entry-tp <
         stopLevel)
         return false;

   }


   return true;

}



//==================================================================
// EXECUTE TRADE v2.33
// ECN compatible
//==================================================================

bool ExecuteTrade(int strategy,
                  int direction)
{


   RefreshRates();



   double atr=
   ATR(1);



   if(atr<=0)
      return false;



   double slDistance=
   atr*InpSL_ATR;



   double tpDistance=
   atr*InpTP_ATR;



   double price;


   double sl;


   double tp;



   if(direction==
      SIGNAL_BUY)
   {

      price=Ask;

      sl=
      price-slDistance;

      tp=
      price+tpDistance;

   }
   else
   {

      price=Bid;

      sl=
      price+slDistance;

      tp=
      price-tpDistance;

   }



   price=
   NormalizeDouble(
   price,Digits);



   sl=
   NormalizeDouble(
   sl,Digits);



   tp=
   NormalizeDouble(
   tp,Digits);



   if(!StopsValid(direction,
                  price,
                  sl,
                  tp))
   {

      Print(
      "B33 INVALID STOPS"
      );


      return false;

   }



   double lots=

   CalculateLots(
   slDistance);



   if(lots<=0)
   {

      Print(
      "B33 INVALID LOT"
      );


      return false;

   }



   int type=

   direction==SIGNAL_BUY?
   OP_BUY:
   OP_SELL;



   string comment=

   "B33_"+
   StrategyName(strategy);



   ResetLastError();



   //---------------------------------------------------------------
   // ECN MODE
   //---------------------------------------------------------------

   int ticket=

   OrderSend(
      Symbol(),
      type,
      lots,
      price,
      InpSlippage,
      0,
      0,
      comment,
      InpMagicNumber,
      0,
      clrNONE
   );



   if(ticket<0)
   {

      int error=
      GetLastError();


      gOrderSendErrors++;


      Print(
      "B33 ORDER ERROR=",
      error
      );


      return false;

   }



   //---------------------------------------------------------------
   // Attach stops
   //---------------------------------------------------------------

   if(OrderSelect(ticket,
                  SELECT_BY_TICKET))
   {

      bool modified=

      OrderModify(
      ticket,
      OrderOpenPrice(),
      sl,
      tp,
      0,
      clrNONE);



      if(!modified)
      {

         Print(
         "B33 MODIFY ERROR=",
         GetLastError()
         );

      }

   }



   gOpenedTrades++;


   gStrategyOpened[strategy]++;



   gLastTradeBarTime=

   iTime(Symbol(),
         Period(),
         1);



   gLastTradeDirection=
   direction;



   Print(
   "B33 OPENED ",
   StrategyName(strategy),
   " ",
   direction==SIGNAL_BUY?
   "BUY":"SELL",
   " LOT=",
   DoubleToString(lots,2)
   );



   return true;

}
