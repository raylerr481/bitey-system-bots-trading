//==================================================================
// RAW SIGNAL ENGINE
//==================================================================


int RawSignal(int strategy,int shift)
{

   if(shift<2)
      return SIGNAL_NONE;



   double close0=
      iClose(Symbol(),
             Period(),
             shift);



   double close1=
      iClose(Symbol(),
             Period(),
             shift+1);



   double emaFast=
      EMA(InpFastEMA,shift);


   double emaSlow=
      EMA(InpSlowEMA,shift);


   double emaTrend=
      EMA(InpTrendEMA,shift);



   double rsi=
      RSI(shift);



   double adx=
      ADX(shift);



   double atr=
      ATR(shift);



   if(atr<=0)
      return SIGNAL_NONE;



//==================================================================
// TREND STRATEGY
//==================================================================


if(strategy==STRAT_TREND)
{

   if(adx>=InpTrendADX &&
      close0>emaTrend &&
      emaFast>emaSlow &&
      close0>emaFast)
   {
      return SIGNAL_BUY;
   }



   if(adx>=InpTrendADX &&
      close0<emaTrend &&
      emaFast<emaSlow &&
      close0<emaFast)
   {
      return SIGNAL_SELL;
   }



   // adaptive trend entry

   if(InpAdaptiveEntry &&
      adx>=InpTrendADXFailsafe)
   {

      if(emaFast>emaSlow &&
         close0>emaSlow &&
         rsi>=48)
      {
         return SIGNAL_BUY;
      }



      if(emaFast<emaSlow &&
         close0<emaSlow &&
         rsi<=52)
      {
         return SIGNAL_SELL;
      }

   }

}



//==================================================================
// MEAN REVERSION
//==================================================================


if(strategy==STRAT_MEANREV)
{

   if(adx<=InpRangeADX &&
      rsi<=30)
   {
      return SIGNAL_BUY;
   }



   if(adx<=InpRangeADX &&
      rsi>=70)
   {
      return SIGNAL_SELL;
   }

}



//==================================================================
// MOMENTUM
//==================================================================


if(strategy==STRAT_MOMENTUM)
{

   double body=
      CandleBody(shift);



   if(body>=atr*InpMomentumBodyATR &&
      close0>close1 &&
      close0>emaFast &&
      emaFast>emaSlow &&
      rsi>50)
   {
      return SIGNAL_BUY;
   }



   if(body>=atr*InpMomentumBodyATR &&
      close0<close1 &&
      close0<emaFast &&
      emaFast<emaSlow &&
      rsi<50)
   {
      return SIGNAL_SELL;
   }

}



//==================================================================
// BREAKOUT
//==================================================================


if(strategy==STRAT_BREAKOUT)
{

   double high12=-DBL_MAX;

   double low12=DBL_MAX;



   for(int i=shift+1;
       i<=shift+12;
       i++)
   {

      high12=
      MathMax(high12,
              iHigh(Symbol(),
                    Period(),
                    i));

      low12=
      MathMin(low12,
              iLow(Symbol(),
                   Period(),
                   i));

   }



   if(close0>high12 &&
      adx>=InpTrendADX)
   {
      return SIGNAL_BUY;
   }



   if(close0<low12 &&
      adx>=InpTrendADX)
   {
      return SIGNAL_SELL;
   }



   // adaptive breakout


   if(InpAdaptiveEntry &&
      adx>=InpTrendADXFailsafe)
   {

      double buffer=
         atr*InpBreakoutATRBuffer;



      if(close0>high12-buffer)
         return SIGNAL_BUY;



      if(close0<low12+buffer)
         return SIGNAL_SELL;

   }

}



//==================================================================
// SESSION STRATEGY
//==================================================================


if(strategy==STRAT_SESSION)
{

   int hour=
      TimeHour(
      iTime(Symbol(),
            Period(),
            shift));



   if(hour>=InpSessionStart &&
      hour<InpSessionEnd)
   {


      bool bullish=
         close0>
         iOpen(Symbol(),
               Period(),
               shift);



      bool bearish=
         close0<
         iOpen(Symbol(),
               Period(),
               shift);



      if(emaFast>emaSlow &&
         close0>=emaFast &&
         rsi>=50)
      {
         return SIGNAL_BUY;
      }



      if(emaFast<emaSlow &&
         close0<=emaFast &&
         rsi<=50)
      {
         return SIGNAL_SELL;
      }



      // adaptive session entry


      if(InpAdaptiveEntry)
      {

         if(bullish &&
            close0>emaSlow &&
            rsi>=InpSessionRSIBuy)
         {
            return SIGNAL_BUY;
         }



         if(bearish &&
            close0<emaSlow &&
            rsi<=InpSessionRSISell)
         {
            return SIGNAL_SELL;
         }

      }

   }

}



//==================================================================
// DIVERGENCE
//==================================================================


if(strategy==STRAT_DIVERGENCE)
{

   double oldRSI=
      RSI(shift+3);



   double oldLow=
      iLow(Symbol(),
           Period(),
           shift+3);



   double oldHigh=
      iHigh(Symbol(),
            Period(),
            shift+3);



   if(adx<=InpRangeADX)
   {

      if(close0<oldLow &&
         rsi>oldRSI &&
         rsi<50)
      {
         return SIGNAL_BUY;
      }



      if(close0>oldHigh &&
         rsi<oldRSI &&
         rsi>50)
      {
         return SIGNAL_SELL;
      }

   }

}



//==================================================================
// RANGE
//==================================================================


if(strategy==STRAT_RANGE)
{

   if(adx<=InpRangeADX)
   {

      double high10=-DBL_MAX;

      double low10=DBL_MAX;



      for(int r=shift+1;
          r<=shift+10;
          r++)
      {

         high10=
         MathMax(high10,
                 iHigh(Symbol(),
                       Period(),
                       r));



         low10=
         MathMin(low10,
                 iLow(Symbol(),
                      Period(),
                      r));

      }



      double range=
         high10-low10;



      if(range>0)
      {

         if(close0<=low10+range*0.25 &&
            rsi<45)
            return SIGNAL_BUY;



         if(close0>=high10-range*0.25 &&
            rsi>55)
            return SIGNAL_SELL;

      }

   }

}



//==================================================================
// FRACTAL HTF
//==================================================================


if(strategy==STRAT_FRACTAL_HTF)
{

   double htfFast=
      iMA(Symbol(),
          PERIOD_H4,
          InpFastEMA,
          0,
          MODE_EMA,
          PRICE_CLOSE,
          1);



   double htfSlow=
      iMA(Symbol(),
          PERIOD_H4,
          InpSlowEMA,
          0,
          MODE_EMA,
          PRICE_CLOSE,
          1);



   if(htfFast>htfSlow &&
      close0>emaFast)
   {
      return SIGNAL_BUY;
   }



   if(htfFast<htfSlow &&
      close0<emaFast)
   {
      return SIGNAL_SELL;
   }

}



return SIGNAL_NONE;

}



