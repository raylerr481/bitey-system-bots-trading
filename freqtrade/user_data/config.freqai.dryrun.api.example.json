{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "bot_name": "bitey-sbt-freqai-dryrun-api",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "spot",
  "stake_currency": "USDT",
  "stake_amount": 100,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "1h",
  "max_open_trades": 2,
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": ["BTC/USDT", "ETH/USDT"],
    "pair_blacklist": []
  },
  "pairlists": [{"method": "StaticPairList"}],
  "api_server": {
    "enabled": true,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET",
    "CORS_origins": [],
    "username": "REPLACE_WITH_LOCAL_API_USERNAME",
    "password": "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
  },
  "db_url": "sqlite:////freqtrade/user_data/tradesv3.freqai.api.dryrun.sqlite",
  "initial_state": "running",
  "force_entry_enable": false,
  "freqai": {
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "identifier": "bitey-freqai-v1",
    "live_retrain_hours": 24,
    "expiration_hours": 48,
    "save_backtest_models": false,
    "feature_parameters": {
      "include_timeframes": ["1h"],
      "include_corr_pairlist": ["ETH/USDT"],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [10, 20, 50]
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "random_state": 42
    }
  },
  "internals": {"process_throttle_secs": 5}
}
