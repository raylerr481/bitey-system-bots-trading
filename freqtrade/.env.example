# Optional local Freqtrade REST API credentials.
# Never commit the real values.
BITEY_FREQTRADE_USER=replace_me
BITEY_FREQTRADE_PASSWORD=replace_me
BITEY_FREQTRADE_URL=http://127.0.0.1:8080
BITEY_FREQTRADE_TIMEOUT=10

# Optional Freqtrade config overrides.
# These are applied only when exported into the container environment.
FREQTRADE__API_SERVER__USERNAME=replace_me
FREQTRADE__API_SERVER__PASSWORD=replace_me
FREQTRADE__API_SERVER__JWT_SECRET_KEY=replace_with_32_plus_random_chars
